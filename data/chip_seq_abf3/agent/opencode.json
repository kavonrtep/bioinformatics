{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "permission": {
    "edit": "allow",
    "external_directory": "ask",
    "webfetch": "deny",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "mv *": "ask",
      "conda *": "ask",
      "pip *": "ask",
      "wget *": "ask",
      "curl *": "ask",
      "sudo *": "deny"
    }
  }
}
